# Air quality — https://aqicn.org/data-platform/token/
WAQI_TOKEN=your-waqi-token

# Weather — https://openweathermap.org/api (optional: Open-Meteo is used as fallback)
OPENWEATHER_API_KEY=your-openweathermap-key

# AWS credentials. Read by boto3 straight from the environment, not through
# app/config.py — see the note there.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# DynamoDB. AWS_REGION must match the region the table was created in.
AWS_REGION=ap-south-1
DYNAMO_TABLE_NAME=city_intelligence_readings

# Write a snapshot to DynamoDB on each /current call
PERSIST_READINGS=true

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
